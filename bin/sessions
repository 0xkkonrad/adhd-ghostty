    (['            cands = [k for k in by_key if k not in assigned and titles.get(k) == want]\n'],
     '            cands = [k for k in by_key if k not in assigned and titles.get(k) and\n                     (titles[k] == want or (by_key[k]["program"].get("kind") == "codex" and\n                                            titles[k] == (codex_title_parts(want) or {}).get("name")))]\n'),
    (['                windows[wi]["tabs"][si] = {"id": old_tab, "title": ""}\n                moved[old_tab] = old_tab\n'],
     '                windows[wi]["tabs"][si] = {"id": old_tab, "title": "", "anchored": True}\n                moved[old_tab] = old_tab\n'),
    (['        tid = new_tab(wi, si) if windows[wi]["tabs"][si] is None else windows[wi]["tabs"][si]["id"]\n        reg_s[k] = {"tab": tid, "kind": "tab", "dir": None, "seq": v["seq"] if v else reg["seq"]}\n'],
     '        tid = new_tab(wi, si) if windows[wi]["tabs"][si] is None else windows[wi]["tabs"][si]["id"]\n        windows[wi]["tabs"][si]["anchored"] = True\n        reg_s[k] = {"tab": tid, "kind": "tab", "dir": None, "seq": v["seq"] if v else reg["seq"]}\n'),
    (['    # finalize: drop unfilled slots, copy titles from the tab bar\n'],
     '    # finalize: drop unfilled slots, copy titles from the tab bar (all of them when the counts agree, else\n    # only tabs that were anchored by their title; the position of the rest is a guess)\n'),
    (['            if si < len(slot_titles) and len(w["tabs"]) == len(slot_titles):\n                t["title"] = slot_titles[si]\n            tabs.append(t)\n'],
     '            if si < len(slot_titles) and (len(w["tabs"]) == len(slot_titles) or t.pop("anchored", False)):\n                t["title"] = slot_titles[si]\n            t.pop("anchored", None)\n            tabs.append(t)\n'),
    (['        return f"codex {p.get(\'id\') or \'?\'}  ({cwd})"\n'],
     '        return f"codex {p.get(\'id\') or \'?\'}  {p.get(\'label\') or \'\'}  ({cwd})".rstrip()\n'),
]


def install_ghostty_session():
    g = read(GS_BIN)
    if not g:
        return [f"!! {GS_BIN} missing"]
    new = g
    for olds, repl in GS_REPLACES:
        if repl in new:
            continue
        for o in olds:
            if o in new:
                new = new.replace(o, repl, 1)
                break
    for snippet, anchor in GS_INSERTS:
        if snippet in new:
            continue
        if anchor not in new:
            return [f"!! ghostty-session anchor not found: {anchor.strip().splitlines()[0]!r}; nothing written"]
        new = new.replace(anchor, snippet + anchor, 1)
    # the --help router must sit after `cmd, rest = …`, which the save anchor guarantees; sanity: compile
    try:
        compile(new, str(GS_BIN), "exec")
    except SyntaxError as e:
        return [f"!! ghostty-session edit would not compile ({e}); nothing written"]
    if new == g:
        return ["ghostty-session integration already complete"]
    bak = GS_BIN.with_name(GS_BIN.name + f".bak-{time.strftime('%Y%m%d')}")
    if not bak.exists():
        bak.write_text(g)
    GS_BIN.write_text(new)
    return [f"ghostty-session: integration applied (backup {bak.name})"]


PIN_SKILL = '''---
name: pin
description: Pin or unpin this session (keep it for later at the top of the sessions sidebar, no date, never decays). Use only when the user types /pin.
disable-model-invocation: true
---

Run exactly this, with no other steps first (it toggles):

```bash
sessions pin "$CLAUDE_CODE_SESSION_ID" --toggle
```

Reply with one line: pinned (kept in the sidebar's 📌 section, above the history, until unpinned) or unpinned. If it fails, show the error verbatim.
'''


def install():
    did = []
    hook = CLAUDE_DIR / "hooks/tab-status.py"
    src = read(hook)
    if src and "# sessions-touch" not in src:
        bak = hook.with_name(hook.name + f".bak-{time.strftime('%Y%m%d')}")
        bak.write_text(src)
        snippet = (
            "    if ev.get(\"hook_event_name\") == \"UserPromptSubmit\":   # sessions-touch: reactivate on every prompt\n"
            "        try:\n"
            "            exe = os.path.expanduser(\"~/.local/bin/sessions\")\n"
            "            if os.path.exists(exe):\n"
            "                subprocess.Popen([exe, \"touch\", sid_of(ev)], stdin=subprocess.DEVNULL,\n"
            "                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)\n"
            "        except Exception:\n"
            "            pass\n")
        anchor = "    write(os.path.join(STATE, sid_of(ev) + \".state\"), st)\n"
        if anchor in src:
            hook.write_text(src.replace(anchor, anchor + snippet, 1))
            did.append(f"hook line added to {hook} (backup {bak.name})")
        else:
            did.append(f"!! could not find anchor in {hook}; hook line NOT added")
    else:
        did.append("hook line already present" if src else f"!! {hook} missing")
    skills = CLAUDE_DIR / "skills"
    park = skills / "park/SKILL.md"
    park_text = '''---
name: park
description: Park this session (keep it in the sessions backlog, pick it up later). Use only when the user types /park.
argument-hint: "[days|s] [note]"
disable-model-invocation: true
---

Run exactly this, with no other steps first (`$ARGUMENTS` = optional day count or `s` for someday, then a note):

```bash
sessions park "$CLAUDE_CODE_SESSION_ID" --args "$ARGUMENTS"
```

Reply with one line: parked, when it wakes (N days or someday) and the note. If it fails, show the error verbatim.
Tooling: `~/.local/bin/sessions` (docs: ~/fw16-setup/sessions.md).
'''
    if read(park) != park_text:
        park.parent.mkdir(parents=True, exist_ok=True)
        park.write_text(park_text)
        did.append(f"wrote {park}")
    done_ = skills / "done/SKILL.md"
    done_text = '''---
name: done
description: Mark this session done in the sessions ledger (never resume it). Use only when the user types /done.
disable-model-invocation: true
---

Run exactly this, with no other steps first (it takes no arguments):

```bash
sessions done "$CLAUDE_CODE_SESSION_ID"
```

Reply with one line: done, and that the tab can be swept from the sessions sidebar (`s`). If it fails, show the error verbatim.
'''
    if read(done_) != done_text:
        done_.parent.mkdir(parents=True, exist_ok=True)
        done_.write_text(done_text)
        did.append(f"wrote {done_}")
    pin_ = skills / "pin/SKILL.md"
    if read(pin_) != PIN_SKILL:
        pin_.parent.mkdir(parents=True, exist_ok=True)
        pin_.write_text(PIN_SKILL)
        did.append(f"wrote {pin_}")
    did += install_ghostty_session()
    STATE.mkdir(parents=True, exist_ok=True)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    did.append(f"state dir {STATE}, cache dir {CACHE_DIR}")
    print("\n".join(did))
    return 0


def main(argv):
    if not argv:
        return cmd_open()
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help"):
        print(__doc__)
        return 0
    if cmd == "open":
        return cmd_open()
    if cmd == "tui":
        w = None
        if "--width" in rest:
            try:
                w = int(rest[rest.index("--width") + 1])
            except (IndexError, ValueError):
                print("--width needs a number", file=sys.stderr)
                return 2
        if "--once" in rest:
            return cmd_once(w, "--done" in rest, "--all" in rest)
        if not sys.stdin.isatty():
            print("tui needs a terminal (use --once for a single frame)", file=sys.stderr)
            return 2
        return tui(w)
    if cmd == "map":
        return cmd_map("--json" in rest)
    if cmd == "log":
        return cmd_log()
    if cmd in ("park", "done", "touch", "focus", "resume", "pin", "unpin"):
        if not rest or not rest[0]:
            print(f"usage: sessions {cmd} SID ...", file=sys.stderr)
            return 2
        sid = rest[0]
        is_codex = bool(list((CODEX_DIR / "sessions").glob(f"*/*/*/rollout-*{sid}.jsonl"))) if (CODEX_DIR / "sessions").exists() else False
        kind = "codex" if is_codex else "claude"
        if cmd == "park":
            try:
                days, note, someday = parse_park_args(rest[1:])
            except ValueError as e:
                print(f"usage: sessions park SID [--days N | --someday] [--note TEXT]   ({e})", file=sys.stderr)
                return 2
            wake = None if someday else wake_for_days(days, now_ts())
            ledger_append(sid, "parked", kind, wake, note, "skill")
            print(f"parked {sid[:8]}: wakes {'someday' if someday else 'in ' + str(days) + 'd'}" + (f" · {note}" if note else ""))
            return 0
        if cmd == "done":
            ledger_append(sid, "done", kind, src="skill")
            print(f"done {sid[:8]}")
            return 0
        if cmd == "touch":
            mark_active(sid, kind, "hook", throttle=600)       # typing never unpins; one event per 10 min
            return 0
        if cmd in ("pin", "unpin"):
            last = ledger_last().get(sid)
            pinned_now = bool(last and last["state"] == "pinned")
            want = (not pinned_now) if "--toggle" in rest else (cmd == "pin")
            if want:
                ledger_append(sid, "pinned", kind, src="skill")
                print(f"pinned {sid[:8]}")
            else:
                ledger_append(sid, "active", kind, src="skill")   # open → active; closed → unsorted, countdown from now
                print(f"unpinned {sid[:8]}")
            return 0
        if cmd == "focus":
            return cmd_focus(sid)
        if cmd == "resume":
            model = build_model()
            rec = model["sessions"].get(sid) or {"sid": sid, "kind": kind, "info": None}
            ok, m = do_resume(rec)
            print(("✓ " if ok else "✗ ") + m)
            return 0 if ok else 1
    if cmd == "sweep":
        model = build_model()
        res, err = sweep(model, None, "--dry-run" in rest)
        if err:
            print(f"refused: {err}", file=sys.stderr)
            return 1
        for name, steps in res:
            print(("would close " if "--dry-run" in rest else "closing ") + name + "  " + " ".join(steps))
        return 0
    if cmd == "install":
        return install()
    print("unknown command", cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
